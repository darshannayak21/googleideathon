rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // DEFAULT DENY — nothing is accessible unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile: only the authenticated user can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Sessions: only the owning user
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Messages within a session: only the owning user
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Summaries: only the owning user
      match /summaries/{summaryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
